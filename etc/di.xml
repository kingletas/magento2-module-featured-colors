<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Commerce\FeaturedColors\Api\Data\FeaturedColorInterface"
                type="Commerce\FeaturedColors\Model\FeaturedColor"/>

    <type name="Commerce\FeaturedColors\Model\Config">
        <arguments>
            <argument name="section" xsi:type="string">commerce_featuredcolors</argument>
        </arguments>
    </type>

    <type name="Commerce\FeaturedColors\Model\Catalog\ColorOptionMap">
        <arguments>
            <argument name="attributeCode" xsi:type="string">color</argument>
        </arguments>
    </type>

    <!--
        Set legacyTable to the old JSON-blob table to migrate existing data on
        setup:upgrade.
    -->
    <type name="Commerce\FeaturedColors\Setup\Patch\Data\MigrateLegacyFeaturedColors">
        <arguments>
            <argument name="legacyTable" xsi:type="string"></argument>
            <argument name="legacyColumn" xsi:type="string">default</argument>
            <argument name="logger" xsi:type="object">Commerce\FeaturedColors\Logger</argument>
        </arguments>
    </type>

    <type name="Magento\ImportExport\Model\Import\SampleFileProvider">
        <arguments>
            <argument name="samples" xsi:type="array">
                <item name="commerce_featured_colors" xsi:type="string">Commerce_FeaturedColors</item>
            </argument>
        </arguments>
    </type>

    <type name="Commerce\FeaturedColors\Model\FeaturedColorApplier">
        <arguments>
            <argument name="logger" xsi:type="object">Commerce\FeaturedColors\Logger</argument>
        </arguments>
    </type>
    <type name="Commerce\FeaturedColors\Observer\PersistFeaturedColor">
        <arguments>
            <argument name="logger" xsi:type="object">Commerce\FeaturedColors\Logger</argument>
        </arguments>
    </type>
    <type name="Commerce\FeaturedColors\Observer\SyncBaseImage">
        <arguments>
            <argument name="logger" xsi:type="object">Commerce\FeaturedColors\Logger</argument>
        </arguments>
    </type>

    <virtualType name="Commerce\FeaturedColors\Logger\Handler" type="Commerce\Logger\Handler">
        <arguments>
            <argument name="fileName" xsi:type="string">featured_colors.log</argument>
            <argument name="subDirectory" xsi:type="string">commerce</argument>
        </arguments>
    </virtualType>
    <virtualType name="Commerce\FeaturedColors\Logger" type="Commerce\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">commerce_featured_colors</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Commerce\FeaturedColors\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

</config>
