<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Global, not adminhtml-only: the observer reads a data key on the
        product, so imports, the REST API and CLI reach the same code path.
    -->
    <event name="catalog_product_save_after">
        <observer name="commerce_featured_colors_persist"
                  instance="Commerce\FeaturedColors\Observer\PersistFeaturedColor"/>
    </event>
    <event name="commerce_featured_colors_applied">
        <observer name="commerce_featured_colors_sync_base_image"
                  instance="Commerce\FeaturedColors\Observer\SyncBaseImage"/>
    </event>
</config>
