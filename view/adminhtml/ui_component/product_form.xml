<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="featured_color" sortOrder="90">
        <settings>
            <label translate="true">Featured Colour</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="featuredcolor" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Featured Colour</label>
                <notice translate="true">
                    The colour this configurable leads with in listings. Must match a colour option
                    exactly, and that colour must have an enabled child product.
                </notice>
                <dataScope>featuredcolor</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
